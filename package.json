{
    "name": "@gobing-ai/spur",
    "type": "module",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "prepare": "lefthook install",
        "dev": "bun run --filter '*' dev",
        "build": "bun run --filter '*' build",
        "test": "bun test --coverage --pass-with-no-tests",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . && bun run typecheck",
        "format": "biome check . --write",
        "autofix": "bun run format && bun run typecheck",
        "check": "bun run lint && bun run test"
    },
    "dependencies": {
        "@gobing-ai/ts-db": "^0.1.8",
        "@gobing-ai/ts-infra": "^0.1.8",
        "@gobing-ai/ts-runtime": "^0.1.8",
        "@gobing-ai/ts-utils": "^0.1.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@types/bun": "1.3.14",
        "lefthook": "1.13.0",
        "typescript": "6.0.3"
    }
}

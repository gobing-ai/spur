/.spur/run
/.spur/backups/
# Team-generated specs are runtime scratch materialized by `spur team up` (ADR-086);
# the committed source of truth is the agent.team roster in .spur/config.yaml.
# ponytail: gitignore cannot inspect the spur:generated YAML tag; hand-authored
# specs remain explicitly trackable with `git add -f`. Split filenames only if
# normal `git add` visibility becomes a demonstrated need.
/.spur/agents/*
!/.spur/agents/.gitkeep
/.spur/context/.session*.json
/.spur/context/token-ledger.jsonl
/.spur/memory/sessions/*-checkpoint.md
/.spur/reports/
/.spur/tmp/

logs/
.tmp/
**/.tmp-*/
*.db

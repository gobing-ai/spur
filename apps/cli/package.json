{
    "name": "@gobing-ai/spur-cli",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "spur": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run src/index.ts",
        "build": "bun build src/index.ts --compile --outfile ../../dist/cli/spur",
        "test": "bun test tests --coverage --pass-with-no-tests",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@gobing-ai/spur-config": "workspace:*",
        "@gobing-ai/spur-domain": "workspace:*",
        "@gobing-ai/ts-ai-runner": "catalog:",
        "@gobing-ai/ts-dual-workflow-engine": "catalog:",
        "@gobing-ai/ts-llm-jsonl-importer": "catalog:",
        "@gobing-ai/ts-rule-engine": "catalog:",
        "@gobing-ai/ts-runtime": "catalog:",
        "@gobing-ai/ts-utils": "catalog:",
        "figlet": "^1.11.0"
    },
    "devDependencies": {
        "@types/bun": "catalog:",
        "@types/figlet": "^1.7.0"
    }
}

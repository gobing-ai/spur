{
    "name": "@gobing-ai/spur-cli",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "spur": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "test": "bun test tests --coverage --pass-with-no-tests",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@gobing-ai/spur-config": "workspace:*",
        "@gobing-ai/ts-ai-runner": "link:@gobing-ai/ts-ai-runner",
        "@gobing-ai/ts-db": "^0.1.8",
        "@gobing-ai/ts-dual-workflow-engine": "link:@gobing-ai/ts-dual-workflow-engine",
        "@gobing-ai/ts-llm-jsonl-importer": "link:@gobing-ai/ts-llm-jsonl-importer",
        "@gobing-ai/ts-rule-engine": "link:@gobing-ai/ts-rule-engine",
        "@gobing-ai/ts-runtime": "^0.1.8",
        "@gobing-ai/ts-utils": "^0.1.8"
    },
    "devDependencies": {
        "@types/bun": "1.3.14"
    }
}

{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../../tooling/typescript/react.json",
    "compilerOptions": {
        "types": ["bun"],
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "paths": { "@/*": ["./src/*"] }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "astro.config.mjs",
        "env.d.ts"
    ]
}

# Spur environment variables — process env is a gateway-only surface (env-var-hygiene rule).
#
# Direct `process.env`/`Bun.env` access fails the env-var-hygiene rule outside two zones:
#   1. packages/config/src/** — the sole owner (`getEnvVar` single var; `getEnvVars()` live
#      record for seeding defaults, composing child env maps, or set/delete markers).
#   2. plugins/sp/scripts/env.ts — dependency-free local mirror for portable plugin scripts.
# Application code reads typed config or an injected `env` record parameter instead.
#
# Environment is reserved for three kinds of values:
#   1. Gateway-read config (packages/config registry) — the sanctioned surface below.
#   2. Deployment plane — DATABASE_URL, CORS, PORT/HOST, NODE_ENV.
#   3. Host/parent→child process contracts — set by tools, rarely by hand.
#
# Runtime options do NOT belong here: put them in `.spur/config.yaml` under
# `bootstrap.options` and read them with `getAppOptions`/`getEnvVar` (packages/config).
# Dev-only knobs are consts in source. Any env read outside the gateway zones above fails
# `spur rule run` (env-var-hygiene, error severity — src and tests).

# ── Runtime options live in .spur/config.yaml (task 0902 wave 2) ─────────────
# These knobs were env vars and are now config keys under `bootstrap.options`:
#   schedulerCustomTimeoutMs  # was SPUR_SCHEDULER_CUSTOM_TIMEOUT_MS ('none' = unlimited)
#   schedulerKillGraceMs      # was SPUR_SCHEDULER_KILL_GRACE_MS
#   historyRefreshTimeoutMs   # was SPUR_HISTORY_REFRESH_TIMEOUT_MS ('none' = unlimited)
#   asyncRegisterTimeoutMs    # was SPUR_ASYNC_REGISTER_TIMEOUT_MS
# Provenance overrides now use `spur task update --provenance-bypass` (was SPUR_PROVENANCE_OVERRIDE).

# ── Gateway config (packages/config) ─────────────────────────────────────────
# Server bind address. Defaults: PORT 3111, HOST 127.0.0.1.
#PORT=3111
#HOST=127.0.0.1
# Server log level (trace|debug|info|warn|error|fatal). Default: info.
#SPUR_LOG_LEVEL=info
# Anonymous usage telemetry (off unless explicitly enabled).
#SPUR_TELEMETRY_ENABLED=false
# Telemetry collector endpoint (only needed with SPUR_TELEMETRY_ENABLED=true).
#SPUR_TELEMETRY_ENDPOINT=
# Multi-project registry path. Default: ~/.spur/projects.json.
#SPUR_PROJECTS_FILE=
# Custom slash-command manifest. Default: <project>/.spur/commands.json.
#SPUR_SLASH_COMMANDS_FILE=
# Bypass config-layer discovery (debug/tests): skip global and/or project config.
#SPUR_SKIP_GLOBAL_CONFIG=true
#SPUR_SKIP_PROJECT_CONFIG=true

# ── Deployment plane ─────────────────────────────────────────────────────────
# Postgres connection for the CLI (app workspaces otherwise use file/SQLite).
#DATABASE_URL=postgres://user:pass@host:5432/db
# CORS allow-list for the served web app, comma-separated. Default: same-origin.
#SPUR_CORS_ORIGINS=http://localhost:4321,https://gobing.ai
# Standard Node mode flag (affects web build + server behavior).
#NODE_ENV=development

# ── Web build (apps/web, compile-time via import.meta.env) ───────────────────
# Dev-server API base (Astro dev proxy target).
#PUBLIC_API_URL=http://localhost:3111
#DEV=true

# ── Host-tool contracts (set by coding agents/harness, not by hand) ──────────
# CLAUDE_PROJECT_DIR — project root passed by Claude Code hooks.
# CLAUDE_CODE_ENTRYPOINT — invocation mode (cli|vscode|…) for agent-hint.
# TERM_PROGRAM — terminal vendor hint for agent-hint (iTerm.app, …).
# ANTHROPIC_MODEL / CLAUDE_MODEL / OPENAI_MODEL / SPUR_MODEL — model override ladder in agent-hint.
# SPUR_AGENT / SPUR_DEFAULT_AGENT — agent selection for agent-hint.
# SPUR_CLI_PATH — explicit spur binary for project-start child spawns.
# SPUR_GLOBAL_RULES_DIR / SPUR_RULES_PATH — redirect rule-catalog roots (tests/sandboxes).

# ── Parent→child contracts (set by spur itself) ──────────────────────────────
# SPUR_BIN — absolute spur binary injected into every spawned script/agent.
# SPUR_ROLE — child process role marker (agent-service spawns).
# SPUR_SERVE_URL — serve endpoint handed to supervisor-managed children.
# SPUR_ASYNC_WORKER / SPUR_WORKFLOW_RUN_ACTIVE / SPUR_RUN_ID — workflow-run markers.
# SPUR_EXPECTED_DEFINITION_DIGEST — workflow definition pin for spawned workers.
# SPUR_HISTORY_REFRESH_CONTEXT / SPUR_EVAL_PIPELINE_ACTIVE — re-entrancy guards.
# SPUR_JSON_ENVELOPE — forces JSON output envelope (ADR-091 flag+env contract).
# GIT_INDEX_FILE — git staging isolation for sandboxed index writes.
# FORCE_COLOR / NO_COLOR — standard TTY color forcing (colors.ts).

# ── Invocation contracts (caller sets per invocation) ────────────────────────
# SPUR_HITL_AUTO_APPROVE=1 — auto-approve HITL gates (CI/sandboxes only).
# SPUR_CAREFUL=1 — extra confirmation prompts (task-write-guard).
# SPUR_WRITE_GUARD=1 — enable the task-write guard hook.
# SP_DAILY_SUMMARY_NO_PROMPT=1 — non-interactive daily summary (RD3_ alias deprecated).

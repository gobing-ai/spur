# Spur environment variables — copy to `.env` and set what your deployment needs.
#
# Policy (ADR-120): environment variables are a restricted external surface.
#   - Runtime options live in `.spur/config.yaml` (`bootstrap.options`) or the
#     spur global config file — not here.
#   - Design/dev-time options are constants in source.
#   - Every access goes through the `@gobing-ai/ts-utils` gateway functions,
#     never direct `process.env`/`Bun.env` (env-var-hygiene rule, zero exclusions).
#   - Tool-set process contracts (host tools, parent→child, CI invocation) are
#     set by tooling and documented in ADR-120 — they never belong in this file.

# ── Deployment plane ─────────────────────────────────────────────────────────

# Postgres connection string for the CLI. App workspaces otherwise default to
# file/SQLite storage.
# Example: postgres://user:pass@host:5432/spur
DATABASE_URL=

# Standard Node mode flag ("development" | "production"); affects server
# behavior and the web build.
NODE_ENV=development

# HTTP port for `spur serve`.
PORT=3111

# Bind address for `spur serve`.
HOST=127.0.0.1

# Comma-separated CORS allow-list for the served web app; empty = same-origin
# only.
# Example: http://localhost:4321,https://gobing.ai
SPUR_CORS_ORIGINS=

# ── Application behavior ─────────────────────────────────────────────────────

# Server log level: trace | debug | info | warn | error | fatal.
SPUR_LOG_LEVEL=info

# Anonymous usage telemetry; stays off unless explicitly enabled. When true,
# set SPUR_TELEMETRY_ENDPOINT below.
SPUR_TELEMETRY_ENABLED=false

# Telemetry collector endpoint (only read when SPUR_TELEMETRY_ENABLED=true).
SPUR_TELEMETRY_ENDPOINT=

                    "evidenceEffect": "none"
                },
                "test-recheck:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "write"
                },
                "review:onEnter:0": {
                    "kind": "agent.run",
                    "invocation": "/sp:dev-review ${vars.wbs} --auto",
                    "stateEffect": "may-write",
                    "evidenceEffect": "write"
                },
                "approve:onEnter:0": {
                    "kind": "hitl.confirm",
                    "stateEffect": "read",
                    "evidenceEffect": "none"
                },
                "verify:onEnter:0": {
                    "kind": "agent.run",
                    "invocation": "/sp:dev-verify ${vars.wbs} --auto --fix all --focus all",
                    "stateEffect": "may-write",
                    "evidenceEffect": "write"
                },
                "verify:onEnter:1": {
                    "kind": "shell",
                    "invocation": "$spurBin task verdict $wbs --from-answer .spur/run/$wbs-verify-answer.txt",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "residual-sweep:onEnter:0": {
                    "kind": "shell",
                    "invocation": "mkdir -p .spur/run && { git rev-parse HEAD 2>/dev/null || echo no-head; git status --porcelain 2>/dev/null; } > \".spur/run/$wbs-residual-tree.pre\"",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "residual-sweep:onEnter:1": {
                    "kind": "agent.run",
                    "invocation": "Report—do not fix—anything left incomplete in ${vars.residualSweepTarget}. The tree is under a post-verification proof lock: making any edit invalidates the PASS verdict and fails this run. Write your findings to .spur/run/${vars.wbs}-residual.md as a markdown list (write 'CLEAR' if nothing remains), and change no other file.",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "residual-sweep:onEnter:2": {
                    "kind": "shell",
                    "invocation": "{ git rev-parse HEAD 2>/dev/null || echo no-head; git status --porcelain 2>/dev/null; } > \".spur/run/$wbs-residual-tree.post\"",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "record:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "write"
                },
                "record:onEnter:1": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "done:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "done:onEnter:1": {
                    "kind": "note",
                    "stateEffect": "read",
                    "evidenceEffect": "none"
                },
                "done:onEnter:2": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "write"
                }
            }
        },

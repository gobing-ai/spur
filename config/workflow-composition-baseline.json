                    "kind": "shell",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "implement:onEnter:0": {
                    "kind": "agent.run",
                    "invocation": "/sp:dev-run --mode implement ${vars.wbs} --auto",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "implement:onEnter:1": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "implement:onEnter:2": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "test:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "write"
                },
                "test-fix:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "write"
                },
                "test-fix:onEnter:1": {
                    "kind": "file.read.into-var",
                    "stateEffect": "read",
                    "evidenceEffect": "none"
                },
                "test-fix:onEnter:2": {
                    "kind": "agent.run",
                    "invocation": "/sp:dev-fixall \"${vars.qualityGateCmd}\" --gate-log .spur/run/${vars.wbs}-test-gate.log --findings \"${vars.gateFindings}\"",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "test-recheck:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "write"
                },
                "review:onEnter:0": {
                    "kind": "agent.run",
                    "invocation": "/sp:dev-review ${vars.wbs} --auto",
                    "stateEffect": "may-write",
                    "evidenceEffect": "write"
                },
                "approve:onEnter:0": {
                    "kind": "hitl.confirm",
                    "stateEffect": "read",
                    "evidenceEffect": "none"
                },
                "verify:onEnter:0": {
                    "kind": "agent.run",
                    "invocation": "/sp:dev-verify ${vars.wbs} --auto --fix all --focus all",
                    "stateEffect": "may-write",
                    "evidenceEffect": "write"
                },
                "verify:onEnter:1": {
                    "kind": "shell",
                    "invocation": "$spurBin task verdict $wbs --from-answer .spur/run/$wbs-verify-answer.txt",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "record:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "write"
                },
                "record:onEnter:1": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "done:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "none"

    "workflows": {
        "docs-pipeline": {
            "definition": "config/workflows/docs-pipeline.yaml",
            "boundary": "docs-evolution",
            "disposition": "keep",
            "callers": ["sp:spur-dev", "/sp:dev-run"],
            "terminalStates": ["done", "failed", "cancelled"],
            "artifacts": ["docs-precheck", "docs-verdict"],
            "failurePolicy": "fail-closed",
            "modelQueries": ["draft"],
            "actions": {
                "precheck:onEnter:0": {
                    "kind": "command.gate",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "precheck:onEnter:1": {
                    "kind": "command.gate",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "precheck:onEnter:2": {
                    "kind": "shell",
                    "invocation": "if test \"$(cat .spur/run/$wbs-docs-precheck-task.status 2>/dev/null)\" = PASS &&\n   test \"$(cat .spur/run/$wbs-docs-precheck-agent.status 2>/dev/null)\" = PASS;\nthen printf 'PASS\\n' > \".spur/run/$wbs-docs-precheck.status\"; else printf 'FAIL\\n' > \".spur/run/$wbs-docs-precheck.status\"; fi",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "precheck:onEnter:3": {
                    "kind": "note",
                    "stateEffect": "read",
                    "evidenceEffect": "none"
                },
                "draft:onEnter:0": {
                    "kind": "agent.run",
                    "invocation": "/sp:dev-run --mode implement ${vars.wbs} --auto",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "draft:onEnter:1": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "docs-review:onEnter:0": {
                    "kind": "hitl.confirm",
                    "stateEffect": "read",
                    "evidenceEffect": "none"
                },
                "record:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "write"
                },
                "done:onEnter:0": {
                    "kind": "shell",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "done:onEnter:1": {
                    "kind": "run.artifact",
                    "stateEffect": "read",
                    "evidenceEffect": "write"
                },
                "done:onEnter:2": {
                    "kind": "shell",
                    "stateEffect": "write",
                    "evidenceEffect": "none"
                },
                "done:onEnter:3": {
                    "kind": "note",
                    "stateEffect": "read",
                    "evidenceEffect": "none"
                }
            }
        },

{
    "description": "Spur (sp) plugin hooks — task corpus write protection + destructive-command guard.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp task-write-guard",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}

{
    "description": "Spur (sp) plugin hooks — task corpus write protection + destructive-command confirm + indexed-context token-ledger tracking + fleet lifecycle reporting. Each `superskill hook run sp <id>` resolves to scripts/hooks/<id>.ts (superskill ADR-039).",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp task-write-guard",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp careful-guard",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash|Grep|Glob|Read|Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp context-post-tool",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp context-session-start",
                        "timeout": 15
                    },
                    {
                        "type": "command",
                        "command": "superskill hook run sp agent-lifecycle",
                        "timeout": 5
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp agent-lifecycle",
                        "timeout": 5
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "permission_prompt",
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp agent-lifecycle",
                        "timeout": 5
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp agent-lifecycle",
                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "superskill hook run sp fleet-guest-stop",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "superskill hook run sp context-session-stop",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}

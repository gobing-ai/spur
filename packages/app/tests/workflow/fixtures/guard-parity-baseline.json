{
    "task-pipeline": [
        {
            "from": "precheck",
            "to": "implement",
            "kind": "shell",
            "command": "$spurBin task check $wbs --fix --json > \".spur/run/$wbs-auto-repairs.json\" 2>/dev/null ; $spurBin task check $wbs --precheck"
        },
        {
            "from": "precheck",
            "to": "failed",
            "kind": "always",
            "command": null
        },
        {
            "from": "implement",
            "to": "failed",
            "kind": "shell",
            "command": "n=\"$(cat .spur/run/$wbs-escalation-count 2>/dev/null || echo 0)\"; test \"$n\" -ge \"$maxEscalations\" -a -s .spur/run/$wbs-question.md"
        },
        {
            "from": "implement",
            "to": "escalate",
            "kind": "shell",
            "command": "test -s .spur/run/$wbs-question.md"
        },
        {
            "from": "implement",
            "to": "gate",
            "kind": "always",
            "command": null
        },
        {
            "from": "escalate",
            "to": "implement",
            "kind": "shell",
            "command": "test -n \"$__hitlInput\""
        },
        {
            "from": "escalate",
            "to": "failed",
            "kind": "shell",
            "command": "test -z \"$__hitlInput\""
        },
        {
            "from": "gate",
            "to": "review",
            "kind": "shell",
            "command": "test \"$(cat \".spur/run/$__runId-gate.status\" 2>/dev/null)\" = PASS && test \"$(cat \".spur/run/$wbs-test-gate.status\" 2>/dev/null)\" = PASS"
        },
        {
            "from": "gate",
            "to": "review",
            "kind": "shell",
            "command": "test \"$deferQualityGate\" = \"true\" && test \"$(cat \".spur/run/$__runId-gate.status\" 2>/dev/null)\" = PASS && test \"$(cat \".spur/run/$wbs-test-gate.status\" 2>/dev/null)\" = DEFERRED"
        },
        {
            "from": "gate",
            "to": "failed",
            "kind": "shell",
            "command": "test \"$(cat \".spur/run/$__runId-gate.status\" 2>/dev/null)\" = BLOCKED"
        },
        {
            "from": "gate",
            "to": "failed",
            "kind": "shell",
            "command": "jq -e '.value == \"stop\"' \".spur/run/$wbs-failure-class.decision\" >/dev/null 2>&1"
        },
        {
            "from": "gate",
            "to": "failed",
            "kind": "shell",
            "command": "fix_attempts=\"$(cat .spur/run/$wbs-test-fix-attempt 2>/dev/null || echo 0)\"; test \"$fix_attempts\" -ge \"$qualityGateMaxFixAttempts\""
        },
        {
            "from": "gate",
            "to": "remediate",
            "kind": "shell",
            "command": "jq -e '.value == \"fix\"' \".spur/run/$wbs-failure-class.decision\" >/dev/null 2>&1"
        },
        {
            "from": "gate",
            "to": "failed",
            "kind": "always",
            "command": null
        },
        {
            "from": "remediate",
            "to": "gate",
            "kind": "always",
            "command": null
        },
        {
            "from": "review",
            "to": "done",
            "kind": "shell",
            "command": "test \"$(cat \".spur/run/$wbs-review.status\" 2>/dev/null)\" = PASS && test \"$(cat \".spur/run/$wbs-approval.status\" 2>/dev/null)\" = APPROVED"
        },
        {
            "from": "review",
            "to": "failed",
            "kind": "shell",
            "command": "test \"$(cat \".spur/run/$wbs-approval.status\" 2>/dev/null)\" = DENIED"
        },
        {
            "from": "review",
            "to": "failed",
            "kind": "shell",
            "command": "jq -e '.value == \"stop\"' \".spur/run/$wbs-review-failure-class.decision\" >/dev/null 2>&1"
        },
        {
            "from": "review",
            "to": "failed",
            "kind": "shell",
            "command": "fix_attempts=\"$(cat .spur/run/$wbs-test-fix-attempt 2>/dev/null || echo 0)\"; test \"$fix_attempts\" -ge \"$qualityGateMaxFixAttempts\""
        },
        {
            "from": "review",
            "to": "remediate",
            "kind": "shell",
            "command": "jq -e '.value == \"fix\"' \".spur/run/$wbs-review-failure-class.decision\" >/dev/null 2>&1"
        },
        {
            "from": "review",
            "to": "failed",
            "kind": "always",
            "command": null
        }
    ],
    "idea-pipeline": [
        {
            "from": "start",
            "to": "discovery",
            "kind": "shell",
            "command": "test \"$(cat .spur/run/$__runId-idea-precheck-doctor.status 2>/dev/null)\" = PASS"
        },
        {
            "from": "start",
            "to": "failed",
            "kind": "shell",
            "command": "head -1 .spur/run/$__runId-idea-precheck-doctor.status 2>/dev/null >&2; exit 0"
        },
        {
            "from": "discovery",
            "to": "cancelled",
            "kind": "shell",
            "command": "test \"$profile\" = auto && test \"$idea_approved\" = true && grep -qx drop .spur/run/$__runId-idea-recommendation.txt"
        },
        {
            "from": "discovery",
            "to": "feature-create",
            "kind": "shell",
            "command": "test \"$profile\" = auto && test \"$idea_approved\" = true && grep -qxE \"proceed|reshape\" .spur/run/$__runId-idea-recommendation.txt"
        },
        {
            "from": "discovery",
            "to": "idea-eval",
            "kind": "always",
            "command": null
        },
        {
            "from": "idea-eval",
            "to": "feature-create",
            "kind": "shell",
            "command": "test \"$profile\" = auto && test \"$idea_approved\" = true && grep -qxE \"proceed|reshape\" .spur/run/$__runId-idea-recommendation.txt"
        },
        {
            "from": "idea-eval",
            "to": "feature-create",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = yes"
        },
        {
            "from": "idea-eval",
            "to": "cancelled",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = no || test \"$__hitlAnswer\" = cancel"
        },
        {
            "from": "feature-create",
            "to": "ac-generate",
            "kind": "always",
            "command": null
        },
        {
            "from": "ac-generate",
            "to": "system-design",
            "kind": "shell",
            "command": "test \"$(cat .spur/run/$__runId-idea-ac-ready.status 2>/dev/null)\" = PASS && test \"$(cat .spur/run/$__runId-idea-design-route.txt 2>/dev/null)\" = design"
        },
        {
            "from": "ac-generate",
            "to": "decompose",
            "kind": "shell",
            "command": "test \"$(cat .spur/run/$__runId-idea-ac-ready.status 2>/dev/null)\" = PASS && test \"$(cat .spur/run/$__runId-idea-design-route.txt 2>/dev/null)\" = skip"
        },
        {
            "from": "ac-generate",
            "to": "ac-generate",
            "kind": "shell",
            "command": "ac_status=\"$(cat .spur/run/$__runId-idea-ac-check.status 2>/dev/null)\" retry=\"$(cat .spur/run/$__runId-idea-ac-retry-count 2>/dev/null || echo 0)\"; test \"$ac_status\" != PASS && test \"$retry\" -lt 3"
        },
        {
            "from": "ac-generate",
            "to": "failed",
            "kind": "shell",
            "command": "ac_status=\"$(cat .spur/run/$__runId-idea-ac-check.status 2>/dev/null)\" retry=\"$(cat .spur/run/$__runId-idea-ac-retry-count 2>/dev/null || echo 0)\"; test \"$ac_status\" != PASS && test \"$retry\" -ge 3"
        },
        {
            "from": "system-design",
            "to": "decompose",
            "kind": "shell",
            "command": "test \"$profile\" = auto && test \"$design_approved\" = true && test \"$(cat .spur/run/$__runId-idea-design-check.status 2>/dev/null)\" = PASS"
        },
        {
            "from": "system-design",
            "to": "design-approval",
            "kind": "always",
            "command": null
        },
        {
            "from": "design-approval",
            "to": "decompose",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = yes && test \"$(cat .spur/run/$__runId-idea-design-check.status 2>/dev/null)\" = PASS"
        },
        {
            "from": "design-approval",
            "to": "ac-generate",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = yes && test \"$(cat .spur/run/$__runId-idea-design-check.status 2>/dev/null)\" != PASS"
        },
        {
            "from": "design-approval",
            "to": "system-design",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = no && test \"$(cat .spur/run/$__runId-idea-design-reject-count 2>/dev/null || echo 0)\" -le 1"
        },
        {
            "from": "design-approval",
            "to": "failed",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = no && test \"$(cat .spur/run/$__runId-idea-design-reject-count 2>/dev/null || echo 0)\" -gt 1"
        },
        {
            "from": "design-approval",
            "to": "cancelled",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = cancel"
        },
        {
            "from": "decompose",
            "to": "batch-create-run",
            "kind": "always",
            "command": null
        },
        {
            "from": "batch-create-run",
            "to": "ready-prepare",
            "kind": "shell",
            "command": "test -f .spur/run/$__runId-idea-batch-create.done"
        },
        {
            "from": "batch-create-run",
            "to": "decompose",
            "kind": "shell",
            "command": "test -f .spur/run/$__runId-idea-batch-create.failed && test \"$(cat .spur/run/$__runId-idea-decompose-retry-count 2>/dev/null || echo 0)\" -lt 3"
        },
        {
            "from": "batch-create-run",
            "to": "failed",
            "kind": "shell",
            "command": "test -f .spur/run/$__runId-idea-batch-create.failed && test \"$(cat .spur/run/$__runId-idea-decompose-retry-count 2>/dev/null || echo 0)\" -ge 3"
        },
        {
            "from": "ready-prepare",
            "to": "handoff-finalize",
            "kind": "always",
            "command": null
        },
        {
            "from": "handoff-finalize",
            "to": "handoff",
            "kind": "always",
            "command": null
        }
    ]
}

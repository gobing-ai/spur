{
    "task-pipeline": [
        {
            "from": "precheck",
            "to": "implement",
            "kind": "shell",
            "command": "size_status=\"$(cat .spur/run/$wbs-precheck-size.status 2>/dev/null)\"; evidence_status=\"$(cat .spur/run/$wbs-precheck-evidence.status 2>/dev/null)\"; test \"$size_status\" = PASS && test \"$evidence_status\" = PASS && $spurBin task check $wbs"
        },
        {
            "from": "precheck",
            "to": "failed",
            "kind": "always",
            "command": null
        },
        {
            "from": "implement",
            "to": "failed",
            "kind": "shell",
            "command": "n=\"$(cat .spur/run/$wbs-escalation-count 2>/dev/null || echo 0)\"; test \"$n\" -ge \"$maxEscalations\" -a -s .spur/run/$wbs-question.md"
        },
        {
            "from": "implement",
            "to": "escalate",
            "kind": "shell",
            "command": "test -s .spur/run/$wbs-question.md"
        },
        {
            "from": "implement",
            "to": "test",
            "kind": "always",
            "command": null
        },
        {
            "from": "escalate",
            "to": "implement",
            "kind": "shell",
            "command": "test -n \"$__hitlInput\""
        },
        {
            "from": "escalate",
            "to": "failed",
            "kind": "shell",
            "command": "test -z \"$__hitlInput\""
        },
        {
            "from": "test",
            "to": "verify",
            "kind": "shell",
            "command": "gate_status=\"$(cat .spur/run/$wbs-test-gate.status 2>/dev/null)\"; test \"$gate_status\" = PASS && test \"$mode\" = fast"
        },
        {
            "from": "test",
            "to": "review",
            "kind": "shell",
            "command": "gate_status=\"$(cat .spur/run/$wbs-test-gate.status 2>/dev/null)\"; test \"$gate_status\" = PASS && test \"$mode\" != fast"
        },
        {
            "from": "test",
            "to": "test-fix",
            "kind": "shell",
            "command": "test \"$(cat .spur/run/$wbs-test-gate.status 2>/dev/null)\" = FAIL"
        },
        {
            "from": "test",
            "to": "test-fix",
            "kind": "always",
            "command": null
        },
        {
            "from": "test-fix",
            "to": "test-recheck",
            "kind": "always",
            "command": null
        },
        {
            "from": "test-recheck",
            "to": "verify",
            "kind": "shell",
            "command": "gate_status=\"$(cat .spur/run/$wbs-test-gate.status 2>/dev/null)\"; test \"$gate_status\" = PASS && test \"$mode\" = fast"
        },
        {
            "from": "test-recheck",
            "to": "review",
            "kind": "shell",
            "command": "gate_status=\"$(cat .spur/run/$wbs-test-gate.status 2>/dev/null)\"; test \"$gate_status\" = PASS && test \"$mode\" != fast"
        },
        {
            "from": "test-recheck",
            "to": "test-fix",
            "kind": "shell",
            "command": "gate_status=\"$(cat .spur/run/$wbs-test-gate.status 2>/dev/null)\"; fix_attempts=\"$(cat .spur/run/$wbs-test-fix-attempt 2>/dev/null || echo 0)\"; test \"$gate_status\" = FAIL && test \"$fix_attempts\" -lt \"$qualityGateMaxFixAttempts\""
        },
        {
            "from": "test-recheck",
            "to": "failed",
            "kind": "shell",
            "command": "gate_status=\"$(cat .spur/run/$wbs-test-gate.status 2>/dev/null)\"; fix_attempts=\"$(cat .spur/run/$wbs-test-fix-attempt 2>/dev/null || echo 0)\"; test \"$gate_status\" = FAIL && test \"$fix_attempts\" -ge \"$qualityGateMaxFixAttempts\""
        },
        {
            "from": "test-recheck",
            "to": "failed",
            "kind": "always",
            "command": null
        },
        {
            "from": "review",
            "to": "verify",
            "kind": "shell",
            "command": "test \"$profile\" = auto"
        },
        {
            "from": "review",
            "to": "approve",
            "kind": "always",
            "command": null
        },
        {
            "from": "approve",
            "to": "verify",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = yes"
        },
        {
            "from": "approve",
            "to": "failed",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = no"
        },
        {
            "from": "approve",
            "to": "cancelled",
            "kind": "shell",
            "command": "test \"$__hitlAnswer\" = cancel"
        },
        {
            "from": "verify",
            "to": "record",
            "kind": "shell",
            "command": "jq -e --arg d \"$proofDigest\" --arg r \"$__runId\" --arg dd \"$__definitionDigest\" ' .verdict == \"PASS\" and (.proof.digest // \"\") == $d and (.proof.stages.qualityGate.digest // \"\") == $d and (.proof.stages.review.digest // \"\") == $d and (.proof.stages.review.status // \"\") == \"completed\" and (.proof.stages.verification.digest // \"\") == $d and (.proof.runId // \"\") == $r and (.proof.definitionDigest // \"\") == $dd ' \".spur/run/$wbs-verdict.json\" >/dev/null 2>&1"
        },
        {
            "from": "verify",
            "to": "test-fix",
            "kind": "shell",
            "command": "verdict=\"$(jq -r .verdict .spur/run/$wbs-verdict.json 2>/dev/null)\"; test -n \"$verdict\" && test \"$verdict\" != PASS && test \"$(cat .spur/run/$wbs-test-fix-attempt 2>/dev/null || echo 0)\" -lt \"$qualityGateMaxFixAttempts\""
        },
        {
            "from": "verify",
            "to": "failed",
            "kind": "always",
            "command": null
        },
        {
            "from": "record",
            "to": "done",
            "kind": "shell",
            "command": "$spurBin task check $wbs --as done && verdict=\"$(jq -r .verdict .spur/run/$wbs-verdict.json 2>/dev/null)\" && proof_digest=\"$(jq -r '.proof.digest // \"\"' .spur/run/$wbs-verdict.json 2>/dev/null)\" && test \"$verdict\" = PASS && test \"$proof_digest\" = \"$proofDigest\""
        },
        {
            "from": "record",
            "to": "failed",
            "kind": "always",
            "command": null
        }
    ]
}
